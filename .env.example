# Copy to .env and fill in to enable the Jev decision layer.
# Without JEV_API_KEY the gate runs on the deterministic heuristic provider.

# TypeSafe AI "System One" (Jev) API key — https://typesafe.ai
JEV_API_KEY=
JEV_MODEL=jev-latest

# Optional: path to an alternate policy file (defaults to ./policy.json)
BRG_POLICY_PATH=
